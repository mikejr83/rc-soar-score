root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Dart/Flutter files
[*.dart]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# HTML files
[*.html]
indent_size = 2

# CSS/SCSS files
[*.css]
indent_size = 2

[*.scss]
indent_size = 2