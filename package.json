{
  "name": "score-soar",
  "version": "1.0.0",
  "private": true,
  "description": "RC sailplane soaring contest scoring and management suite",
  "scripts": {
    "build": "bash build.sh",
    "build:api": "cd apps/score-soar-api && flutter build web --release",
    "build:contest": "cd apps/score-soar-contest && flutter build web --release",
    "build:public": "cd apps/score-soar-public && flutter build web --release",
    "serve:api": "cd apps/score-soar-api && flutter run -d chrome",
    "serve:contest": "cd apps/score-soar-contest && flutter run -d chrome",
    "serve:public": "cd apps/score-soar-public && flutter run -d chrome"
  },
  "devDependencies": {
    "nx": "^19.0.0"
  }
}