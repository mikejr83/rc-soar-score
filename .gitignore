# Git Ignore for NX + Flutter Monorepo

# NX cache
.nx/
nx-cache/

# Node modules
node_modules/

# Flutter build artifacts
/build/
apps/*/build/
apps/*/ios/Flutter/

# Flutter/Dart tool & generated files
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
apps/*/lib/*.g.dart
apps/*/test/*.g.dart

# IDEs
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.iml
*.suo
*.user

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp
*.swo

# Flutter applications (including this repo root) must commit pubspec.lock
# for reproducible builds. Do NOT ignore it in this monorepo.

# Coverage reports
coverage/

# Dart/Flutter generated files
*.jks
*.keystore

# Ensure your agent skills are tracked
!.agents/skills/

# Ignore temporary workspaces generated by running the skills
.agents/skills/*-workspace/
graph.html
