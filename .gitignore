# Git Ignore for NX + Flutter Monorepo

# NX cache
.nx/
nx-cache/

# Node modules
node_modules/

# Flutter build artifacts (per app)
apps/*/build/
apps/*/ios/Flutter/
apps/*/android/app/build/

# Flutter IDE files
.dart_tool/
apps/*/.flutter-plugins
apps/*/.flutter-plugins-dependencies
apps/*/.packages
apps/*/.dart_tool/
apps/*/lib/*.g.dart
apps/*/test/*.g.dart

# IDEs
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.iml
*.suo
*.user

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp
*.swo

# Pubspec lock (shared dependency versions)
pubspec.lock

# Coverage reports
coverage/

# Dart/Flutter generated files
*.jks
*.keystore

# Ensure your agent skills are tracked
!.agents/skills/

# Ignore temporary workspaces generated by running the skills
.agents/skills/*-workspace/
graph.html
