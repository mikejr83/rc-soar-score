{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Verify",
      "type": "shell",
      "command": "./scripts/verify.ps1",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "melos: bootstrap",
      "type": "shell",
      "command": "melos",
      "args": ["bootstrap"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "melos: analyze",
      "type": "shell",
      "command": "melos",
      "args": ["analyze"],
      "problemMatcher": ["$dart"],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "melos: test",
      "type": "shell",
      "command": "melos",
      "args": ["test"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "melos: build",
      "type": "shell",
      "command": "melos",
      "args": ["run", "build"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "contest app: run with demo data (Windows)",
      "type": "shell",
      "command": "flutter",
      "args": ["run", "-d", "windows", "--dart-define=SOAR_SCORE_DEMO=true"],
      "options": {
        "cwd": "${workspaceFolder}/apps/soar_score_contest"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "contest app: run with fresh demo data (Windows)",
      "type": "shell",
      "command": "flutter",
      "args": [
        "run",
        "-d",
        "windows",
        "--dart-define=SOAR_SCORE_DEMO=true",
        "--dart-define=SOAR_SCORE_DEMO_RESET=true"
      ],
      "options": {
        "cwd": "${workspaceFolder}/apps/soar_score_contest"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "prettier: format plan docs",
      "type": "shell",
      "command": "npx prettier",
      "args": ["--write", "plan/**/*.md"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
