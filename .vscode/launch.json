{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "soar_score_server",
      "type": "dart",
      "request": "launch",
      "program": "apps/soar_score_server/lib/main.dart",
      "env": {
        "PORT": "8080"
      },
      "console": "debugConsole"
    },
    {
      "name": "soar_score_contest (Web)",
      "type": "flutter",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "apps/soar_score_contest",
      "args": [
        "-d",
        "chrome",
        "--web-port",
        "8091",
        "--web-hostname",
        "127.0.0.1"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "soar_score_contest (Windows)",
      "type": "flutter",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "apps/soar_score_contest",
      "args": [
        "-d",
        "windows"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "soar_score_public (Web)",
      "type": "flutter",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "apps/soar_score_public",
      "args": [
        "-d",
        "chrome",
        "--web-port",
        "8092",
        "--web-hostname",
        "127.0.0.1"
      ],
      "console": "integratedTerminal"
    }
  ]
}
