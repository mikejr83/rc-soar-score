{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API Server",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/soar-score-api/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/soar-score-api",
      "console": "debugConsole"
    },
    {
      "name": "API Server (debug)",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/soar-score-api/lib/main.dart",
      "args": ["--debug"],
      "cwd": "${workspaceFolder}/apps/soar-score-api",
      "console": "debugConsole"
    },
    {
      "name": "Contest App (web)",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/soar-score-contest/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/soar-score-contest",
      "deviceId": "chrome"
    },
    {
      "name": "Public App (web)",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/soar-score-public/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/soar-score-public",
      "deviceId": "chrome"
    },
    {
      "name": "Contest App (windows)",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/soar-score-contest/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/soar-score-contest",
      "deviceId": "windows"
    },
    {
      "name": "API Tests",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/soar-score-api/test",
      "args": [],
      "cwd": "${workspaceFolder}/apps/soar-score-api"
    }
  ]
}
