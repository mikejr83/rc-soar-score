{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "soar_score_server",
      "type": "dart",
      "request": "launch",
      "program": "apps/soar_score_server/lib/main.dart",
      "env": {
        "PORT": "8080",
        "POSTGRES_PASSWORD": "titan#12",
        "AUTH0_DOMAIN": "login.rcsoarscore.com",
        "API_AUDIENCE": "https://soar-score.com/server",
        "CORS_ALLOWED_ORIGINS": "http://127.0.0.1:8091,http://localhost:8091,http://localhost:8092",
        "INVITATION_SECRET": "dev-only-invitation-secret-do-not-use-in-production",
        "SELF_SCORING_BASE_URL": "http://localhost:8092"
      },
      "console": "debugConsole"
    },
    {
      "name": "soar_score_self_score (Web, local)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "apps/soar_score_self_score",
      "args": [
        "-d",
        "chrome",
        "--web-port",
        "8092",
        "--web-hostname",
        "localhost",
        "--dart-define",
        "SOAR_SCORE_API_BASE_URL=http://localhost:8080"
      ],
      "console": "debugConsole"
    },
    {
      "name": "soar_score_contest (Web)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "apps/soar_score_contest",
      "args": [
        "-d",
        "chrome",
        "--web-port",
        "8091",
        "--web-hostname",
        "127.0.0.1",
        "--dart-define",
        "SOAR_SCORE_API_BASE_URL=http://127.0.0.1:8080"
      ],
      "console": "debugConsole"
    },
    {
      "name": "soar_score_contest (Windows)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "apps/soar_score_contest",
      "args": [
        "-d",
        "windows",
        "--dart-define",
        "SOAR_SCORE_LOCAL_DATA_DIRECTORY=${workspaceFolder}/.local-data"
      ],
      "console": "debugConsole"
    },
    {
      "name": "soar_score_contest (Windows, demo data)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "apps/soar_score_contest",
      "args": [
        "-d",
        "windows",
        "--dart-define",
        "SOAR_SCORE_DEMO=true",
        "--dart-define",
        "SOAR_SCORE_LOCAL_DATA_DIRECTORY=${workspaceFolder}/.local-data"
      ],
      "console": "debugConsole"
    },
    {
      "name": "soar_score_contest (Windows, fresh demo data)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "apps/soar_score_contest",
      "args": [
        "-d",
        "windows",
        "--dart-define",
        "SOAR_SCORE_DEMO=true",
        "--dart-define",
        "SOAR_SCORE_DEMO_RESET=true",
        "--dart-define",
        "SOAR_SCORE_LOCAL_DATA_DIRECTORY=${workspaceFolder}/.local-data"
      ],
      "console": "debugConsole"
    },
    {
      "name": "soar_score_contest (E2E, current file)",
      "type": "dart",
      "request": "launch",
      "program": "${file}",
      "cwd": "apps/soar_score_contest",
      "args": [
        "-d",
        "windows",
        "--dart-define",
        "SOAR_SCORE_DEMO=true",
        "--dart-define",
        "SOAR_SCORE_DEMO_RESET=true",
        "--dart-define",
        "SOAR_SCORE_LOCAL_DATA_DIRECTORY=${workspaceFolder}/.local-data"
      ],
      "console": "debugConsole"
    },
  ],
  "compounds": [
    {
      "name": "Server + Contest (Web)",
      "configurations": [
        "soar_score_server",
        "soar_score_contest (Web)"
      ]
    },
    {
      "name": "Server + Contest (Windows)",
      "configurations": [
        "soar_score_server",
        "soar_score_contest (Windows)"
      ]
    },
    {
      "name": "Server + Contest (Windows) + Self-scoring (Web)",
      "configurations": [
        "soar_score_server",
        "soar_score_contest (Windows)",
        "soar_score_self_score (Web, local)"
      ]
    }
  ]
}
