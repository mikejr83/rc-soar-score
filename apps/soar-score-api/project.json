{
  "name": "score-soar-api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/soar-score-api",
  "projectType": "application",
  "targets": {
    "pub-get": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/soar-score-api",
        "command": "dart pub get"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/soar-score-api",
        "command": "dart compile exe lib/main.dart -o build/score-soar-api"
      },
      "dependsOn": ["pub-get"],
      "outputs": ["{projectRoot}/build"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/soar-score-api",
        "command": "dart run lib/main.dart"
      },
      "dependsOn": ["pub-get"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/soar-score-api",
        "command": "dart test"
      },
      "dependsOn": ["pub-get"]
    },
    "analyze": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/soar-score-api",
        "command": "dart analyze"
      },
      "dependsOn": ["pub-get"]
    }
  }
}