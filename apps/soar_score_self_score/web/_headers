# Cloudflare response headers. Copied into the build output by Flutter.
# Unknown paths load index.html through wrangler.jsonc (single-page-application
# fallback), which deep links such as /invitations/{credential} need. Do not
# add a 404.html or _redirects file.

/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  # No referrer at all, so an invitation credential never leaks to another site.
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline' https://cdn.auth0.com https://cdn.flutter.io https://www.gstatic.com/flutter-canvaskit/; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.rcsoarscore.com https://login.rcsoarscore.com https://www.gstatic.com/flutter-canvaskit/; img-src 'self' data: blob: https://lh3.googleusercontent.com https://lh4.googleusercontent.com https://graph.facebook.com https://scontent-*.fbcdn.net https://avatars.githubusercontent.com https://pbs.twimg.com https://abs.twimg.com https://is1-ssl.mzstatic.com https://media.licdn.com https://static.licdn.com https://s.yimg.com https://s.gravatar.com https://secure.gravatar.com https://www.gravatar.com; font-src 'self'; worker-src 'self' blob:; manifest-src 'self'

# Entry points and version files must always revalidate so deploys are picked up.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/flutter_service_worker.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
/main.dart.js
  Cache-Control: no-cache

# Static assets have stable names but rarely change: revalidate daily.
/assets/*
  Cache-Control: public, max-age=3600
/canvaskit/*
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=86400
