# Cloudflare response headers. Copied into the build output by Flutter.
# Unknown paths load index.html through wrangler.jsonc (single-page-application
# fallback), which deep links such as /invitations/{credential} need. Do not
# add a 404.html or _redirects file.

/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  # No referrer at all, so an invitation credential never leaks to another site.
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Entry points and version files must always revalidate so deploys are picked up.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/flutter_service_worker.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
/main.dart.js
  Cache-Control: no-cache

# Static assets have stable names but rarely change: revalidate daily.
/assets/*
  Cache-Control: public, max-age=3600
/canvaskit/*
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=86400
