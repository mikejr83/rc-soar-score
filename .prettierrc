{
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "auto",
  "singleQuote": true,
  "proseWrap": "preserve",
  "overrides": [
    {
      "files": "*.md",
      "options": { "proseWrap": "preserve" }
    },
    {
      "files": ["*.yaml", "*.yml"],
      "options": { "singleQuote": false }
    }
  ]
}